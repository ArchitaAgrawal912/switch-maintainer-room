# ---- Switch
# Server address shown in Switch Console (Home page of your server).
SWITCH_URL=http://localhost:8000
# Gateway -> API Keys -> create a key of type "registration". Only used by `register`.
SWITCH_REGISTRATION_TOKEN=
AGENT_NAME=gatekeeper
# Room ids: run `python -m gatekeeper rooms` after registering, or copy them from Switch Console.
MAINTAINERS_ROOM_ID=
REVIEWS_ROOM_ID=
CONTRIBUTORS_ROOM_ID=
# Optional contributor desk on a second chat app (discord, slack, telegram, teams).
# `setup` creates it on that bridge; DESK_USERNAMES are your usernames there.
DESK_BRIDGE=
DESK_USERNAMES=
DESK_ROOM_ID=
# Switch names of the reviewer agents (comma-separated), as created by the room template.
REVIEWERS=mroom-reviewer-claude,mroom-reviewer-codex
# Chat names allowed to approve. Empty = anyone in the maintainers room.
MAINTAINERS=
# Mattermost/Slack usernames added to every room the Gatekeeper creates.
MAINTAINER_USERNAMES=user
# true = open a side room per PR (pr-<n>-review); false = use REVIEWS_ROOM_ID.
SIDE_ROOMS=true

# ---- GitHub
# Fine-grained token scoped to YOUR FORK only: Issues + Pull requests read/write.
GITHUB_TOKEN=
# The repo the Gatekeeper writes to. Never point this at a repo you don't own.
GITHUB_REPO=your-user/switch-maintainer-room-demo
ISSUE_LABEL=hackathon
# Where to count each person's open PRs (the real repo, read-only).
COUNT_PRS_REPO=sandbox-quantum/switch
# Logins whose comments are never treated as requests (maintainers, bots).
IGNORE_LOGINS=
MAX_OPEN_PRS=5
POLL_SECONDS=60

# ---- Safety
# true = replayed logins are real people: label instead of assign, never @mention them.
REPLAY_MODE=true
# true = log GitHub writes instead of sending them.
DRY_RUN=false
# true = handle clear-cut cases without asking (one eligible requester, rule-breaking PRs,
# PRs both reviewers call low-effort/broken). Contested issues, merges and disagreements
# always go to a person. Every auto action is posted with `undo <id>` and logged.
AUTO_MODE=false
# Reviewer agent that picks the best plan when several people are eligible (default: first reviewer).
PLAN_JUDGE=
# Seconds to wait for the judge before falling back to the plan score.
JUDGE_TIMEOUT=180
LOG_LEVEL=INFO
